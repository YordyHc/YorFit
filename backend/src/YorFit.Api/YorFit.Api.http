@YorFit.Api_HostAddress = http://localhost:5215
@branchId = 01a180e1-81eb-7f29-928a-b4cccf6dab92
@roleId = 01a1b6a2-d6ec-7361-9bef-8f7a8a2c0f49

### Consultar una sede por ID
GET {{YorFit.Api_HostAddress}}/api/sedes/{{branchId}}
Accept: application/json

### Listar todas las sedes
GET {{YorFit.Api_HostAddress}}/api/sedes/filtrado
Accept: application/json

### Buscar por nombre parcial
GET {{YorFit.Api_HostAddress}}/api/sedes/filtrado?nombre=Centro
Accept: application/json

### Buscar por código parcial
GET {{YorFit.Api_HostAddress}}/api/sedes/filtrado?codigo=CEN
Accept: application/json

### Buscar sedes activas
GET {{YorFit.Api_HostAddress}}/api/sedes/filtrado?activo=true
Accept: application/json

### Buscar sedes inactivas
GET {{YorFit.Api_HostAddress}}/api/sedes/filtrado?activo=false
Accept: application/json

### Combinar nombre, código y estado
GET {{YorFit.Api_HostAddress}}/api/sedes/filtrado?nombre=Centro&codigo=CEN&activo=true
Accept: application/json

### Búsqueda sin coincidencias: debe devolver una lista vacía
GET {{YorFit.Api_HostAddress}}/api/sedes/filtrado?nombre=NoExiste
Accept: application/json

### Crear sede
POST {{YorFit.Api_HostAddress}}/api/sedes
Content-Type: application/json
Accept: application/json

{
  "nombre": "Sede Centro",
  "codigo": "CENTRO",
  "lineaDireccion1": "Av. Principal 123",
  "lineaDireccion2": null,
  "distrito": "Centro",
  "provincia": "Lima",
  "referencia": "Frente al parque",
  "pais": "Perú",
  "codigoPais": "+51",
  "numeroNacional": "987654321"
}

### Actualizar datos de la sede
PUT {{YorFit.Api_HostAddress}}/api/sedes/{{branchId}}
Content-Type: application/json
Accept: application/json

{
  "nombre": "Sede Centro Actualizada",
  "codigo": "CENTRO",
  "lineaDireccion1": "Av. Principal 456",
  "lineaDireccion2": "AA.HH Los Jardines",
  "distrito": "Centro",
  "provincia": "Lima",
  "referencia": "Frente al parque",
  "pais": "Perú",
  "codigoPais": "+51",
  "numeroNacional": "987654321"
}

### Activar la sede
PATCH {{YorFit.Api_HostAddress}}/api/sedes/{{branchId}}/estado
Content-Type: application/json
Accept: application/json

{
  "activo": true
}

### Desactivar la sede
PATCH {{YorFit.Api_HostAddress}}/api/sedes/{{branchId}}/estado
Content-Type: application/json
Accept: application/json

{
  "activo": false
}

### Eliminar sede (borrado físico)
DELETE {{YorFit.Api_HostAddress}}/api/sedes/{{branchId}}
Accept: application/json


###ROL
### Consultar una rol por ID
GET {{YorFit.Api_HostAddress}}/api/roles/{{roleId}}
Accept: application/json

### Listar todas las roles
GET {{YorFit.Api_HostAddress}}/api/roles/filtrado
Accept: application/json

### Buscar por nombre parcial
GET {{YorFit.Api_HostAddress}}/api/roles/filtrado?nombre=Admin
Accept: application/json

### Buscar roles activas
GET {{YorFit.Api_HostAddress}}/api/roles/filtrado?estado=true
Accept: application/json

### Buscar roles inactivas
GET {{YorFit.Api_HostAddress}}/api/roles/filtrado?estado=false
Accept: application/json

### Combinar nombre, código y estado
GET {{YorFit.Api_HostAddress}}/api/roles/filtrado?nombre=Admin&estado=true
Accept: application/json

### Búsqueda sin coincidencias: debe devolver una lista vacía
GET {{YorFit.Api_HostAddress}}/api/roles/filtrado?nombre=NoExiste
Accept: application/json

### Crear rol
POST {{YorFit.Api_HostAddress}}/api/roles
Content-Type: application/json
Accept: application/json

{
  "nombre": "Admin",
  "descripcion": "Controla todas las funciones del sistema"
}

### Actualizar datos de la rol
PUT {{YorFit.Api_HostAddress}}/api/roles/{{roleId}}
Content-Type: application/json
Accept: application/json

{
  "nombre": "Administrador",
  "descripcion": "Controla todas las funciones del sistema Yorfit"
}

### Activar rol
PATCH {{YorFit.Api_HostAddress}}/api/roles/{{roleId}}/estado
Content-Type: application/json
Accept: application/json

{
  "estado": true
}

### Desactivar rol
PATCH {{YorFit.Api_HostAddress}}/api/roles/{{roleId}}/estado
Content-Type: application/json
Accept: application/json

{
  "estado": false
}

### Eliminar rol (borrado físico)
DELETE {{YorFit.Api_HostAddress}}/api/roles/{{roleId}}
Accept: application/json